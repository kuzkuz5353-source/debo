#!/usr/bin/env bash
# Hiroki OS - Donanım Algılama Motoru
# Neox 1.0 - hiroki-hw-detect
# /proc/meminfo, /proc/cpuinfo, lspci, lsblk, systemd-detect-virt kullanarak analiz yapar
# Hiroki OS artık tek masaüstü sunar: NEOX. Bu araç yalnızca donanım bilgisini
# toplar ve NEOX'un minimum gereksinimleri karşılanıyor mu diye bilgilendirir;
# masaüstü seçimi yapmaz.
# Çıktı: JSON -> /tmp/hiroki-hw-info.json ve STDOUT

set -euo pipefail

OUTPUT_FILE="${1:-/tmp/hiroki-hw-info.json}"

# --- RAM (MB) ---
get_ram_mb() {
    local mem_kb
    mem_kb=$(grep -m1 '^MemTotal:' /proc/meminfo | awk '{print $2}')
    echo $(( mem_kb / 1024 ))
}

# --- CPU Çekirdek Sayısı ---
get_cpu_cores() {
    if command -v nproc >/dev/null 2>&1; then
        nproc --all
    else
        grep -c '^processor' /proc/cpuinfo
    fi
}

# --- CPU Model ---
get_cpu_model() {
    grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | xargs || echo "Bilinmeyen CPU"
}

# --- GPU Bilgisi ---
get_gpu_info() {
    local gpu_raw gpu_vendor gpu_type
    if command -v lspci >/dev/null 2>&1; then
        gpu_raw=$(lspci | grep -i -E 'vga|3d|display' | head -n1 || echo "Unknown GPU")
    else
        gpu_raw="lspci bulunamadı"
    fi

    # Vendor tespiti
    gpu_vendor="unknown"
    gpu_type="unknown"
    local lower
    lower=$(echo "$gpu_raw" | tr '[:upper:]' '[:lower:]')
    if echo "$lower" | grep -qi nvidia; then
        gpu_vendor="NVIDIA"
        gpu_type="nvidia"
    elif echo "$lower" | grep -qi amd || echo "$lower" | grep -qi radeon; then
        gpu_vendor="AMD"
        gpu_type="amd"
    elif echo "$lower" | grep -qi intel; then
        gpu_vendor="Intel"
        gpu_type="intel"
    elif echo "$lower" | grep -qi vmware || echo "$lower" | grep -qi virtualbox || echo "$lower" | grep -qi qxl || echo "$lower" | grep -qi virtio; then
        gpu_vendor="Virtual"
        gpu_type="virtual"
    fi
    # Pipe karakterini temizle
    gpu_raw=$(echo "$gpu_raw" | sed 's/"/\\"/g')
    echo "$gpu_raw|$gpu_vendor|$gpu_type"
}

# --- Disk Alanı (GB) ---
get_disk_gb() {
    local disk_kb
    # En büyük disk'i al (lsblk)
    if command -v lsblk >/dev/null 2>&1; then
        # byte cinsinden en büyük disk
        local bytes
        bytes=$(lsblk -bdn -o SIZE | sort -n | tail -n1)
        if [[ -n "$bytes" ]]; then
            echo $(( bytes / 1024 / 1024 / 1024 ))
            return
        fi
    fi
    # fallback: df
    df --output=size -B1 / | tail -n1 | awk '{print int($1/1024/1024/1024)}'
}

# --- Sanal Makine Kontrolü ---
get_virt() {
    if command -v systemd-detect-virt >/dev/null 2>&1; then
        local v
        v=$(systemd-detect-virt 2>/dev/null || echo "none")
        echo "$v"
    else
        echo "none"
    fi
}

# NEOX (Hyprland tabanlı Wayland masaüstü) için önerilen minimum: 4 GB RAM.
NEOX_MIN_RAM_MB=4096

# --- ANA ÇALIŞMA ---
RAM_MB=$(get_ram_mb)
CPU_CORES=$(get_cpu_cores)
CPU_MODEL=$(get_cpu_model | sed 's/"/\\"/g')
GPU_LINE=$(get_gpu_info)
GPU_RAW=$(echo "$GPU_LINE" | cut -d'|' -f1)
GPU_VENDOR=$(echo "$GPU_LINE" | cut -d'|' -f2)
GPU_TYPE=$(echo "$GPU_LINE" | cut -d'|' -f3)
DISK_GB=$(get_disk_gb)
VIRT=$(get_virt)
IS_VM="false"
if [[ "$VIRT" != "none" && "$VIRT" != "" ]]; then
    IS_VM="true"
fi

if [[ $RAM_MB -lt $NEOX_MIN_RAM_MB ]]; then
    MESSAGE="Donanımınız NEOX için önerilen ${NEOX_MIN_RAM_MB}MB RAM'in altında; performans sorunları yaşayabilirsiniz."
else
    MESSAGE="Donanımınız NEOX (Hyprland tabanlı) masaüstünü rahatça çalıştırabilir."
fi

# JSON oluştur
cat > "$OUTPUT_FILE" <<EOF
{
  "ram_mb": $RAM_MB,
  "ram_gb": $(awk "BEGIN {printf \"%.1f\", $RAM_MB/1024}"),
  "cpu_cores": $CPU_CORES,
  "cpu_model": "$CPU_MODEL",
  "gpu_raw": "$GPU_RAW",
  "gpu_vendor": "$GPU_VENDOR",
  "gpu_type": "$GPU_TYPE",
  "disk_gb": $DISK_GB,
  "virt": "$VIRT",
  "is_vm": $IS_VM,
  "message": "$MESSAGE",
  "recommended": "neox",
  "all_des": "neox",
  "timestamp": "$(date -Iseconds)"
}
EOF

# Ayrıca stdout'a da yaz
cat "$OUTPUT_FILE"

exit 0
