#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Hiroki OS Kernel Manager

Oyun performansı için özel olarak optimize edilmiş çekirdek (kernel)
sürümlerini listeler, tek tıkla indirir/kurar ve GRUB ile entegre eder.

Desteklenen çekirdekler resmi Arch depolarından (extra) ve Chaotic-AUR
üzerinden sağlanır. Bir çekirdek kurulduğunda:
  1. pacman ile ilgili linux-* ve linux-*-headers paketleri kurulur.
  2. grub-mkconfig -o /boot/grub/grub.cfg çalıştırılarak GRUB menüsüne
     otomatik olarak eklenir.
  3. Kullanıcı yeniden başlatınca GRUB'dan istediği çekirdeği seçebilir.

PyQt6 tabanlıdır, root gerektiren adımlar pkexec ile yapılır.
"""

import sys
import subprocess
import shutil

try:
    from PyQt6.QtWidgets import (
        QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
        QLabel, QPushButton, QFrame, QListWidget, QListWidgetItem,
        QMessageBox, QTextEdit, QProgressBar, QScrollArea
    )
    from PyQt6.QtCore import Qt, QThread, pyqtSignal
    from PyQt6.QtGui import QFont
except ImportError:
    print("Hata: PyQt6 bulunamadi. 'pacman -S python-pyqt6' ile kurun.")
    sys.exit(1)

ACCENT = "#FF8C00"
BG_MAIN = "#111111"
BG_CARD = "#1a1a1a"
TEXT_COLOR = "#e0e0e0"
TEXT_DIM = "#888888"
BORDER_COLOR = "#333333"
SUCCESS = "#4caf50"
ERROR = "#f44336"

# Çekirdek kataloğu: paket adı, başlık, açıklama, kaynak, header paketi
KERNELS = [
    {
        "id": "linux",
        "name": "Linux (Varsayılan)",
        "desc": "Arch Linux resmi, en uyumlu ve stabil vanilla çekirdek. Değişiklik gerekmiyorsa bu kalsın.",
        "pkg": "linux",
        "headers": "linux-headers",
        "source": "Resmi Depo (core)",
    },
    {
        "id": "linux-zen",
        "name": "Linux-Zen (Oyun İçin Önerilen)",
        "desc": "Düşük gecikme (low-latency) odaklı, masaüstü ve oyun performansı için ayarlanmış zamanlayıcı (BORE/CFS ayarları) içerir. Arch'ın resmi alternatif oyun çekirdeği.",
        "pkg": "linux-zen",
        "headers": "linux-zen-headers",
        "source": "Resmi Depo (extra)",
    },
    {
        "id": "linux-lts",
        "name": "Linux-LTS (Kararlılık Odaklı)",
        "desc": "Uzun süreli destek sürümü. En kararlı seçenek; performans yerine sağlamlık öncelikli.",
        "pkg": "linux-lts",
        "headers": "linux-lts-headers",
        "source": "Resmi Depo (extra)",
    },
    {
        "id": "linux-hardened",
        "name": "Linux-Hardened (Güvenlik Odaklı)",
        "desc": "Ekstra güvenlik sertleştirmeleri içerir; hafif performans kaybı olabilir.",
        "pkg": "linux-hardened",
        "headers": "linux-hardened-headers",
        "source": "Resmi Depo (extra)",
    },
    {
        "id": "linux-cachyos",
        "name": "Linux-CachyOS BORE (En Yüksek Oyun Performansı)",
        "desc": "CachyOS'in BORE zamanlayıcılı, agresif derleme optimizasyonlu (x86-64-v3) özel oyun çekirdeği. Chaotic-AUR deposu gerektirir.",
        "pkg": "linux-cachyos-bore",
        "headers": "linux-cachyos-bore-headers",
        "source": "Chaotic-AUR (üçüncü parti)",
    },
    {
        "id": "linux-xanmod",
        "name": "Linux-Xanmod (Akıcılık Odaklı)",
        "desc": "PREEMPT_DYNAMIC ve düşük girdi gecikmesi optimizasyonları içeren topluluk çekirdeği.",
        "pkg": "linux-xanmod",
        "headers": "linux-xanmod-headers",
        "source": "AUR (üçüncü parti)",
    },
]

CHAOTIC_AUR_SNIPPET = """
[chaotic-aur]
Include = /etc/pacman.d/chaotic-mirrorlist
"""


def run_cmd(cmd, timeout=20):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip(), r.stderr.strip(), r.returncode
    except Exception as e:
        return "", str(e), -1


def is_installed(pkg):
    _, _, code = run_cmd(["pacman", "-Qi", pkg], timeout=10)
    return code == 0


def has_chaotic_aur():
    _, _, code = run_cmd(["grep", "-q", "chaotic-aur", "/etc/pacman.conf"], timeout=5)
    return code == 0


class InstallWorker(QThread):
    progress = pyqtSignal(str)
    done = pyqtSignal(bool, str)

    def __init__(self, kernel):
        super().__init__()
        self.kernel = kernel

    def run(self):
        k = self.kernel
        script_lines = []
        if k["source"].startswith("Chaotic-AUR") and not has_chaotic_aur():
            script_lines.append(
                "pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com && "
                "pacman-key --lsign-key 3056513887B78AEB && "
                "pacman -U --noconfirm "
                "'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst' "
                "'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst'"
            )
            script_lines.append(
                f"grep -q chaotic-aur /etc/pacman.conf || echo '{CHAOTIC_AUR_SNIPPET}' >> /etc/pacman.conf"
            )
        script_lines.append("pacman -Sy --noconfirm")
        script_lines.append(f"pacman -S --needed --noconfirm {k['pkg']} {k['headers']}")
        script_lines.append(
            "if [ -f /boot/grub/grub.cfg ]; then grub-mkconfig -o /boot/grub/grub.cfg; fi"
        )
        full_script = " && \\\n".join(script_lines)

        self.progress.emit(f"'{k['name']}' kuruluyor, lütfen bekleyin...")
        try:
            proc = subprocess.Popen(
                ["pkexec", "bash", "-c", full_script],
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1
            )
            for line in iter(proc.stdout.readline, ""):
                if line:
                    self.progress.emit(line.rstrip())
            proc.wait()
            if proc.returncode == 0:
                self.done.emit(True, f"{k['name']} başarıyla kuruldu ve GRUB menüsüne eklendi.")
            else:
                self.done.emit(False, f"Kurulum başarısız oldu (kod: {proc.returncode}).")
        except Exception as e:
            self.done.emit(False, str(e))


class KernelManagerWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Hiroki OS Kernel Manager")
        self.setMinimumSize(760, 560)
        self.worker = None
        self._build_ui()
        self._populate_list()

    def _build_ui(self):
        central = QWidget()
        self.setCentralWidget(central)
        outer = QVBoxLayout(central)
        outer.setContentsMargins(20, 20, 20, 20)
        outer.setSpacing(14)

        title = QLabel("Hiroki OS Kernel Manager")
        title.setStyleSheet(f"color: {ACCENT}; font-size: 20px; font-weight: bold;")
        outer.addWidget(title)

        subtitle = QLabel(
            "Oyun performansı için özel olarak optimize edilmiş çekirdekleri listeleyin, "
            "tek tıkla indirin ve GRUB ile entegre edin."
        )
        subtitle.setWordWrap(True)
        subtitle.setStyleSheet(f"color: {TEXT_DIM}; font-size: 12px;")
        outer.addWidget(subtitle)

        self.list_widget = QListWidget()
        self.list_widget.setSpacing(6)
        outer.addWidget(self.list_widget, 1)

        self.detail_box = QTextEdit()
        self.detail_box.setReadOnly(True)
        self.detail_box.setMaximumHeight(90)
        outer.addWidget(self.detail_box)

        btn_row = QHBoxLayout()
        self.btn_install = QPushButton("Seçili Çekirdeği Kur / Güncelle")
        self.btn_install.clicked.connect(self.on_install)
        btn_row.addWidget(self.btn_install)

        self.btn_current = QPushButton("Mevcut Çekirdek Bilgisi")
        self.btn_current.clicked.connect(self.on_show_current)
        btn_row.addWidget(self.btn_current)

        btn_row.addStretch()
        btn_close = QPushButton("Kapat")
        btn_close.clicked.connect(self.close)
        btn_row.addWidget(btn_close)
        outer.addLayout(btn_row)

        self.status_label = QLabel("Hazır.")
        self.status_label.setWordWrap(True)
        self.status_label.setStyleSheet(f"color: {TEXT_DIM}; font-size: 11px;")
        outer.addWidget(self.status_label)

        self.list_widget.currentRowChanged.connect(self._on_selection_changed)

        self.setStyleSheet(f"""
            QMainWindow, QWidget {{ background-color: {BG_MAIN}; color: {TEXT_COLOR}; }}
            QListWidget {{
                background-color: {BG_CARD}; border: 1px solid {BORDER_COLOR}; border-radius: 8px;
                padding: 6px; font-size: 13px;
            }}
            QListWidget::item {{ padding: 10px; border-radius: 6px; }}
            QListWidget::item:selected {{ background-color: {ACCENT}; color: #1a1000; }}
            QTextEdit {{
                background-color: {BG_CARD}; border: 1px solid {BORDER_COLOR}; border-radius: 8px;
                color: {TEXT_DIM}; font-size: 11px; padding: 8px;
            }}
            QPushButton {{
                background-color: #1e1e1e; color: {TEXT_COLOR}; border: 1px solid {BORDER_COLOR};
                border-radius: 6px; padding: 9px 16px;
            }}
            QPushButton:hover {{ background-color: {ACCENT}; color: #1a1000; }}
        """)

    def _populate_list(self):
        self.list_widget.clear()
        for k in KERNELS:
            installed = is_installed(k["pkg"])
            label = f"{'✅ ' if installed else ''}{k['name']}  —  {k['source']}"
            item = QListWidgetItem(label)
            self.list_widget.addItem(item)
        if KERNELS:
            self.list_widget.setCurrentRow(0)

    def _on_selection_changed(self, row):
        if row < 0 or row >= len(KERNELS):
            return
        k = KERNELS[row]
        installed = is_installed(k["pkg"])
        text = f"{k['desc']}\n\nPaket: {k['pkg']} + {k['headers']}\nKaynak: {k['source']}\n"
        text += "Durum: Kurulu" if installed else "Durum: Kurulu değil"
        self.detail_box.setPlainText(text)

    def on_install(self):
        row = self.list_widget.currentRow()
        if row < 0:
            return
        k = KERNELS[row]
        confirm = QMessageBox.question(
            self, "Onay",
            f"'{k['name']}' kurulacak ve GRUB menüsüne eklenecek. Devam edilsin mi?"
        )
        if confirm != QMessageBox.StandardButton.Yes:
            return
        self.btn_install.setEnabled(False)
        self.worker = InstallWorker(k)
        self.worker.progress.connect(self._on_progress)
        self.worker.done.connect(self._on_install_done)
        self.worker.start()

    def _on_progress(self, line):
        self.status_label.setText(line[-200:])

    def _on_install_done(self, success, msg):
        self.btn_install.setEnabled(True)
        color = SUCCESS if success else ERROR
        self.status_label.setText(msg)
        self.status_label.setStyleSheet(f"color: {color}; font-size: 11px;")
        if success:
            QMessageBox.information(self, "Hiroki OS Kernel Manager", msg + "\n\nDeğişikliklerin etkili olması için yeniden başlatın.")
        else:
            QMessageBox.warning(self, "Hata", msg)
        self._populate_list()

    def on_show_current(self):
        out, _, _ = run_cmd(["uname", "-r"], timeout=5)
        QMessageBox.information(self, "Mevcut Çekirdek", f"Şu anda çalışan çekirdek:\n\n{out}")


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Hiroki OS Kernel Manager")
    app.setStyle("Fusion")
    window = KernelManagerWindow()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
